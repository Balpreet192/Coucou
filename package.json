{
  "name": "coucou",
  "version": "1.0.0",
  "private": true,
  "description": "Coucou website and Capacitor Android app",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build:web": "node scripts/build-web.mjs",
    "assets:generate": "npx @capacitor/assets generate --android",
    "android:add": "npm run build:web && cap add android && npm run assets:generate",
    "android:sync": "npm run build:web && cap sync android",
    "android:open": "cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.3",
    "@capacitor/app": "^7.0.1",
    "@capacitor/core": "^7.4.3",
    "@capacitor/splash-screen": "^7.0.1",
    "@capacitor/status-bar": "^7.0.1"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^7.4.3",
    "esbuild": "^0.25.0"
  }
}
